"""Stages a CMake source tree for rules_foreign_cc.

rules_foreign_cc's `cmake()` rule needs a `lib_source` whose files all live
under one directory that is *not* the workspace root, and it needs a single
label that spans the whole tree. Neither holds for protobuf's checkout:
`CMakeLists.txt` is at the root, and nearly every directory under `src/` is a
Bazel package, so no `glob()` can cross them. The same problem exists for
dependencies fetched as Bazel modules (e.g. `@jsoncpp`), whose Bazel-side
`BUILD.bazel` files expose no target spanning their CMake sources.

This repository rule mirrors the requested directories and files of a source
tree -- this repository's or a dependency's, selected by `root` -- into an
external repository as per-file symlinks, skipping Bazel package markers
(`BUILD`, `BUILD.bazel`, ...) so that the generated root `BUILD.bazel` can
`glob()` the entire tree. File contents are tracked through the symlinks, and
the staged directories are watched so added/removed files trigger a re-stage.

The staged tree is intentionally coarse (whole directories rather than the
exact file list CMake compiles). That keeps it robust against CMake's own
`file(GLOB ...)` usage; the cost is that any change under these directories
invalidates the CMake build action. `exclude` trims files that CMake never
reads (documentation, Bazel-side tooling, test goldens) out of the staged
target so that editing them does not trigger a rebuild, and `filegroups`
defines narrower views of the tree for builds that only read part of it.
"""

_BUILD_HEADER = """\
# Generated by //cmake:cmake_source_repo.bzl. Do not edit.

package(default_visibility = ["//visibility:public"])

exports_files(["CMakeLists.txt"])
"""

_FILEGROUP = """
filegroup(
    name = %s,
    srcs = glob(
        %s,
        exclude = %s,
    ),
)
"""

def _build_file(rctx):
    common_exclude = ["BUILD.bazel"] + rctx.attr.exclude
    text = _BUILD_HEADER
    text += _FILEGROUP % (repr("srcs"), repr(["**"]), repr(common_exclude))
    for name, patterns in rctx.attr.filegroups.items():
        if name == "srcs":
            fail("cmake_source_repo: filegroup name 'srcs' is reserved")
        include = [p for p in patterns if not p.startswith("-")]
        exclude = [p[1:] for p in patterns if p.startswith("-")]
        if not include:
            fail("cmake_source_repo: filegroup '%s' has no include patterns" % name)
        text += _FILEGROUP % (repr(name), repr(include), repr(common_exclude + exclude))
    return text

# Files that would turn a staged directory into a Bazel package or repository
# boundary, which would break the root-level glob above.
_SKIPPED_BASENAMES = [
    "BUILD",
    "BUILD.bazel",
    "MODULE.bazel",
    "REPO.bazel",
    "WORKSPACE",
    "WORKSPACE.bazel",
    "WORKSPACE.bzlmod",
]

def _stage_directory(rctx, src_dir, dst_dir):
    """Symlinks every regular file under src_dir to the same path under dst_dir."""

    # Starlark has no recursion; walk with an explicit stack.
    pending = [(src_dir, dst_dir)]
    for _ in range(1000000):
        if not pending:
            break
        src, dst = pending.pop()
        for child in src.readdir():
            name = child.basename
            if name in _SKIPPED_BASENAMES:
                continue
            if child.is_dir:
                pending.append((child, dst.get_child(name)))
            else:
                rctx.symlink(child, dst.get_child(name))

def _cmake_source_repo_impl(rctx):
    root = rctx.path(rctx.attr.root).dirname

    for rel_dir in rctx.attr.dirs:
        src_dir = root.get_child(rel_dir)
        if not src_dir.exists:
            fail("cmake_source_repo: directory does not exist: %s" % rel_dir)
        rctx.watch_tree(src_dir)
        _stage_directory(rctx, src_dir, rctx.path(rel_dir))

    for rel_file in rctx.attr.files:
        src_file = root.get_child(rel_file)
        if not src_file.exists:
            fail("cmake_source_repo: file does not exist: %s" % rel_file)
        rctx.watch(src_file)
        rctx.symlink(src_file, rctx.path(rel_file))

    rctx.file("BUILD.bazel", _build_file(rctx))

cmake_source_repo = repository_rule(
    implementation = _cmake_source_repo_impl,
    doc = "Mirrors part of a source tree into an external repository as a single buildable source tree.",
    attrs = {
        "root": attr.label(
            doc = "Any file at the root of the tree to stage; its directory is the root. " +
                  "Point it into a dependency's module repository (e.g. `@jsoncpp//:CMakeLists.txt`) " +
                  "to stage that dependency's sources.",
            default = Label("//:CMakeLists.txt"),
        ),
        "dirs": attr.string_list(
            doc = "Root-relative directories to stage recursively.",
            mandatory = True,
        ),
        "files": attr.string_list(
            doc = "Root-relative individual files to stage.",
            default = [],
        ),
        "exclude": attr.string_list(
            doc = "Root-relative `glob()` patterns excluded from `//:srcs` and from every " +
                  "filegroup in `filegroups`. The files are still staged, but are not inputs " +
                  "of the CMake build, so editing them does not invalidate it.",
            default = [],
        ),
        "filegroups": attr.string_list_dict(
            doc = "Additional filegroups, each a narrower view of the staged tree: name -> " +
                  "root-relative `glob()` patterns, where a leading `-` marks an exclude " +
                  "pattern. A CMake build that reads only part of the tree (e.g. the library " +
                  "build with tests off) can use such a view as `lib_source` so that edits " +
                  "outside the view do not invalidate it.",
            default = {},
        ),
    },
    local = True,
)
