    sha256 = "64424e96e2457abbac899b90f9530985b51eef2905951febd935f0e73414caeb",
    version = "3.11.0",
)
python_headers.nuget_package(
    cpu = "i686",
    sha256 = "c5ceeef9556d6aa85fac5d6567d35418a978e9b349f2c71818ddc03f14dd5a6d",
    version = "3.11.0",
)
python_headers.nuget_package(
    cpu = "x86-64",
    sha256 = "e1236188a5841cfb9d14f7aac8b1fbdea10f82260d7f63610cc6260db76062a5",
    version = "3.11.0",
)
use_repo(
    python_headers,
    "nuget_python_i686_3.11.0",
    "nuget_python_x86-64_3.11.0",
    "python-3.11.0",
)

bazel_dep(name = "jq.bzl", version = "0.6.1", dev_dependency = True)

jq = use_extension("@jq.bzl//jq:extensions.bzl", "toolchains", dev_dependency = True)
use_repo(jq, "jq_toolchains")

