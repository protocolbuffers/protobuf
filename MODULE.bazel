################################################################################
# CMake builds under Bazel with cmake_bazel() (see //cmake:cmake_bazel.bzl).
#
# Everything in this section is dev-only, so downstream Bazel consumers of
# protobuf never see it. cmake_bazel() uses the official CMake and Ninja Linux
# x86_64 release binaries below, and builds protobuf's CMake dependencies
# (GoogleTest, Abseil) itself from the module repos pinned by the bazel_dep()s
# above -- the same versions cmake/dependencies.cmake gives the CMake build --
# so there is a single version pin and download per dependency.
################################################################################
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "cmake_bazel_cmake",
    build_file_content = """
filegroup(
    name = "cmake",
    srcs = glob(["**"], exclude = ["**/* *"]),
    visibility = ["//visibility:public"],
)
""",
    dev_dependency = True,
    sha256 = "630615d8e98ac33eba7fbe472626dff5c899c85af3c024585ae109166a6909d0",
    strip_prefix = "cmake-3.31.8-linux-x86_64",
    urls = ["https://github.com/Kitware/CMake/releases/download/v3.31.8/cmake-3.31.8-linux-x86_64.tar.gz"],
)

http_archive(
    name = "cmake_bazel_ninja",
    build_file_content = """
exports_files(["ninja"], visibility = ["//visibility:public"])
""",
    dev_dependency = True,
    sha256 = "0830252db77884957a1a4b87b05a1e2d9b5f658b8367f82999a941884cbe0238",
    urls = ["https://github.com/ninja-build/ninja/releases/download/v1.13.1/ninja-linux.zip"],
)

# CMake source trees staged into external repositories as single buildable
# trees, see cmake/cmake_source_repo.bzl. protobuf's CMakeLists.txt sits at the
# workspace root and the per-package BUILD files under src/ prevent one
# filegroup from spanning the tree; the dependency module repos expose no such
# target either.
cmake_source_repo = use_repo_rule("//cmake:cmake_source_repo.bzl", "cmake_source_repo")

cmake_source_repo(
    name = "protobuf-cmake-src",
    dev_dependency = True,
    dirs = [
        "cmake",
        "conformance",
        # The per-language feature protos that cmake/install.cmake installs
        # with the headers (release_all_options_protos_files in
        # src/file_lists.cmake), alongside the Java one below.
        "csharp/google/protobuf",
        "editions",
        "go/google/protobuf",
        "java/core/src/main/resources",
        "src",
        "third_party/utf8_range",
        "upb",
        "upb_generator",
    ],
    # Staged but not inputs of the CMake build: files CMake never reads, so
    # that editing them does not rebuild protobuf. (Bazel package markers are
    # skipped by the rule itself; examples/ is not staged at all since
    # protobuf_BUILD_EXAMPLES and protobuf_INSTALL_EXAMPLES are off.)
    exclude = [
        "**/*.md",
        "cmake/*.bzl",
        "cmake/*.py",
        "cmake/*.sh",
        "cmake/installed_*_golden.txt",
    ],
    # `lib_srcs` is the view read by //cmake:protobuf_cmake_bazel
    # (protobuf_BUILD_TESTS=OFF, protobuf_BUILD_CONFORMANCE=OFF): the tree
    # minus tests, test utilities, test data and conformance, so that
    # test-only edits do not rebuild the libraries. Checked against
    # src/file_lists.cmake: none of the libprotobuf*/libprotoc/libupb/protoc
    # file lists match these patterns.
    filegroups = {
        # `cmake_files` is what the configure action reads: the files CMake
        # itself reads while configuring the library build (CMake scripts,
        # configure_file() templates, and the linker version scripts named in
        # link options), minus the test-only CMake files excluded from
        # `lib_srcs` too. Source edits never re-configure.
        "cmake_files": [
            "CMakeLists.txt",
            "**/CMakeLists.txt",
            "**/*.cmake",
            "**/*.in",
            "src/*.map",
            "-cmake/conformance.cmake",
            "-cmake/gtest.cmake",
            "-cmake/tests.cmake",
        ],
        # Views for the test build (cmake/protobuf_cmake_bazel.bzl): its
        # CMake files (including the test ones), the test sources it compiles,
        # everything that is not code (headers, .proto files, test data), the
        # .proto files its protobuf_generate() steps read, and what the test
        # executables read at run time (they run from the source tree root).
        # test_code is checked against the test file lists in
        # src/file_lists.cmake; configure fails if CMake compiles a file
        # missing from it.
        "test_cmake_files": [
            "CMakeLists.txt",
            "**/CMakeLists.txt",
            "**/*.cmake",
            "**/*.in",
            "src/*.map",
        ],
        "test_code": [
            "conformance/**/*.cc",
            "editions/**/*.cc",
            "**/test/**/*.cc",
            "**/test_util/**/*.cc",
            "**/testing/**/*.cc",
            "**/mock_*.cc",
            "**/unittest*.cc",
            "**/*_plugin.cc",
            "**/*_test.cc",
            "**/*_tester.cc",
            "**/*_unittest.cc",
            "**/*test_util*.cc",
            "upb/**/test.cc",
        ],
        "non_code": [
            "**",
            "-**/*.c",
            "-**/*.cc",
            "-**/*.cpp",
        ],
        "protos": ["**/*.proto"],
        "test_data": [
            "conformance/**",
            "editions/**",
            "src/**",
            "upb/**",
        ],
        # Headers the CMake build includes that are not sources of any Bazel
        # cc_library: checked-in generated code used only by CMake, and .inc
        # fragments; added to every compile of //cmake:protobuf_cmake_bazel.
        "common_hdrs": [
            "**/*.inc",
            "**/cmake/**/*.h",
            "src/google/protobuf/**/*.pb.h",
        ],
        "lib_srcs": [
            "**",
            "-cmake/conformance.cmake",
            "-cmake/gtest.cmake",
            "-cmake/tests.cmake",
            "-conformance/**",
            "-editions/**",
            "-**/test/**",
            "-**/testdata/**",
            "-**/testing/**",
            "-**/*_test.cc",
            "-**/*_test.h",
            "-**/*_test.inc",
            "-**/*_unittest.cc",
            "-**/*_unittest.h",
            "-**/*_unittest.inc",
            "-**/*_unittest*.proto",
            "-**/unittest*",
            "-**/*test_util*",
            "-**/test_*.proto",
            "-**/mock_*",
        ],
    },
    files = [
        "CMakeLists.txt",
        "LICENSE",
        "version.json",
    ],
)

# jsoncpp (for protobuf_BUILD_CONFORMANCE), from the @jsoncpp module repo.
cmake_source_repo(
