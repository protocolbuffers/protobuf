)

# For each staged dependency, `cmake_files` is what its configure action reads
# (CMake scripts, templates, and any other file CMake reads while configuring),
# and `srcs` is everything else its build and install read.
cmake_source_repo(
    name = "googletest-cmake-src",
    dev_dependency = True,
    dirs = [
        "googlemock",
        "googletest",
    ],
    exclude = [
        "**/*.md",
        "googlemock/test/**",
        "googletest/samples/**",
        "googletest/test/**",
    ],
    filegroups = {
        "cmake_files": [
            "CMakeLists.txt",
            "**/CMakeLists.txt",
            "**/*.cmake",
            "**/*.in",
        ],
        # gtest-all.cc and gmock-all.cc #include the other library sources
        # instead of compiling them separately.
        "textual_srcs": [
            "googlemock/src/*.cc",
            "googletest/src/*.cc",
            "-googlemock/src/gmock-all.cc",
            "-googlemock/src/gmock_main.cc",
            "-googletest/src/gtest-all.cc",
            "-googletest/src/gtest_main.cc",
        ],
    },
    files = [
        "CMakeLists.txt",
        "LICENSE",
    ],
    root = "@googletest//:CMakeLists.txt",
)

cmake_source_repo(
    name = "abseil-cpp-cmake-src",
    dev_dependency = True,
    dirs = [
        "CMake",
        "absl",
    ],
    exclude = ["**/*.md"],
    filegroups = {
        "cmake_files": [
            "CMakeLists.txt",
            "**/CMakeLists.txt",
            "**/*.cmake",
            "**/*.in",
            # Read by the install rules in CMakeLists.txt while configuring,
            # to generate the installed copy with the compiled ABI options.
            "absl/base/options.h",
        ],
        # Abseil's sources minus tests and benchmarks (ABSL_BUILD_TESTING is
        # off), so they get no compile actions. If CMake compiles one of
        # them anyway, configure fails rather than skipping it.
        "lib_srcs": [
            "**",
            "-**/*_benchmark.cc",
            "-**/*_test.cc",
        ],
        # The one *_test.cc compiled into a test helper library
        # (per_thread_sem_test_common, built with ABSL_BUILD_TEST_HELPERS).
        "test_helper_srcs": [
            "absl/synchronization/internal/per_thread_sem_test.cc",
        ],
    },
    files = [
        "CMakeLists.txt",
        "LICENSE",
    ],
    root = "@abseil-cpp//:CMakeLists.txt",
)

