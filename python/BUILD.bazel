load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//python:build_targets.bzl", "build_targets")
load("//python:cc_link_bundle.bzl", "py_extension_with_bundled_deps")
load("//upb/bazel:copts.bzl", "UPB_DEFAULT_COPTS", "UPB_DEFAULT_FEATURES")

build_targets(name = "python")

licenses(["notice"])

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//python/dist:__pkg__"],
)

LIMITED_API_FLAG_SELECT = {
    ":limited_api_3.11": ["-DPy_LIMITED_API=0x030b0000"],
    "//conditions:default": [],
}

bool_flag(
    name = "limited_api",
    build_setting_default = True,
)

# Explicit opt-in for experimental CPython free-threading wheels. Keep this
# disabled for ordinary builds until the native extension is fully qualified.
bool_flag(
    name = "experimental_free_threading",
    build_setting_default = False,
)

config_setting(
    name = "experimental_free_threading_enabled",
    flag_values = {":experimental_free_threading": "True"},
)

config_setting(
    name = "limited_api_enabled",
    flag_values = {":limited_api": "True"},
    visibility = ["//python:__subpackages__"],
)

string_flag(
    name = "python_version",
    build_setting_default = "system",
    values = [
        "system",
        "311",
    ],
)

bool_flag(
    name = "use_hermetic_python",
    build_setting_default = False,
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "is_system_python",
    flag_values = {
        ":python_version": "system",
        ":use_hermetic_python": "false",
    },
    visibility = [
        "//:__subpackages__",
        "@local_toolchains//:__pkg__",
    ],
)

config_setting(
    name = "limited_api_3.11",
    flag_values = {
        ":limited_api": "True",
        ":python_version": "311",
    },
)

config_setting(
    name = "limited_api_3.11_win32",
    constraint_values = [
        "@platforms//cpu:x86_32",
        "@platforms//os:windows",
    ],
    flag_values = {
        ":limited_api": "True",
        ":python_version": "311",
    },
)

config_setting(
    name = "limited_api_3.11_win64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    flag_values = {
        ":limited_api": "True",
        ":python_version": "311",
    },
)

_message_target_compatible_with = {
    "@system_python//:none": ["@platforms//:incompatible"],
    "@system_python//:unsupported": ["@platforms//:incompatible"],
    "//conditions:default": [],
}

filegroup(
    name = "message_srcs",
    srcs = [
        "buffer_convert.c",
        "buffer_convert.h",
        "convert.c",
        "convert.h",
        "def_lookup.c",
        "def_lookup.h",
        "descriptor.c",
        "descriptor.h",
        "descriptor_containers.c",
        "descriptor_containers.h",
        "descriptor_pool.c",
        "descriptor_pool.h",
        "extension_dict.c",
        "extension_dict.h",
        "free_threading/access.c",
        "free_threading/access.h",
        "free_threading/lazy_ptr.c",
        "free_threading/lazy_ptr.h",
        "free_threading/mutex.h",
        "free_threading/weak_map.c",
        "free_threading/weak_map.h",
        "map.c",
        "map.h",
        "message.c",
        "message.h",
        "protobuf.c",
        "protobuf.h",
        "python_api.h",
        "repeated.c",
        "repeated.h",
        "unknown_fields.c",
        "unknown_fields.h",
    ],
)

# Equivalent to py_extension(), except on Bazel 8 in OSS. See cc_link_bundle.bzl.
py_extension_with_bundled_deps(
    name = "google/_upb/_message",
    srcs = [":message_srcs"],
    copts = UPB_DEFAULT_COPTS + select(LIMITED_API_FLAG_SELECT) + select({
        ":experimental_free_threading_enabled": ["-DPROTOBUF_PYTHON_EXPERIMENTAL_FREE_THREADING"],
        "//conditions:default": [],
    }),
    features = UPB_DEFAULT_FEATURES,
    # copybara:uncomment py_limited_api = "3.10",
    target_compatible_with = select(_message_target_compatible_with),
    visibility = [
        ":__subpackages__",
        "//conformance:__pkg__",
    ],
    deps = [
        ":breaking_changes",
        "//src/google/protobuf:descriptor_upb_minitable_proto",
        "//src/google/protobuf:descriptor_upb_reflection_proto",
        "//third_party/utf8_range",
        "//upb/base",
        "//upb/hash",
        "//upb/mem",
        "//upb/message",
        "//upb/message:compare",
        "//upb/message:copy",
        "//upb/message:message_unknowns",
        "//upb/mini_table",
        "//upb/port",
        "//upb/reflection",
        "//upb/reflection:internal",
        "//upb/text",
        "//upb/util:def_to_proto",
        "//upb/util:required_fields",
        "//upb/wire",
        "//upb/wire:encode_extension",
        "//upb/wire:eps_copy_input_stream",
        "//upb/wire:reader",
        "@abseil-cpp//absl/base:core_headers",
    ],
)

cc_library(
    name = "free_threading_access",
    srcs = ["free_threading/access.c"],
    hdrs = ["free_threading/access.h"],
    copts = UPB_DEFAULT_COPTS,
    features = UPB_DEFAULT_FEATURES,
    deps = ["//upb/port"],
)

cc_test(
    name = "free_threading_access_test",
    size = "small",
    srcs = [
        "free_threading/access_test.cc",
        "free_threading/access_test_util.c",
        "free_threading/access_test_util.h",
    ],
    deps = [
        ":free_threading_access",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
